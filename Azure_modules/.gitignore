# Terraform provider binaries / plugin cache
**/.terraform/*

# State files (contain secrets and resource details)
*.tfstate
*.tfstate.*

# Variable files (contain admin_password etc.)
*.tfvars
*.tfvars.json

# Crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
